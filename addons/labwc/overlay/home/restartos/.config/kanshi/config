# Applied by kanshi whenever outputs change (boot, monitor wake, hotplug),
# unlike a one-shot wlr-randr in autostart. Per-monitor profiles go above
# this catch-all, e.g.:  profile desk { output HDMI-A-1 enable scale 2
#                                       exec restartos-display changed }
# "enable" is required: rc.xml sets autoEnableOutputs=no, so kanshi is what
# turns outputs on. No scale here: restartos-display autoscale picks it from
# each output's resolution (2 from 1440p up, 1.2 at 1080p), then does the
# idle/waybar refit (see restartos-display).
profile {
	output * enable
	exec restartos-display autoscale
}
