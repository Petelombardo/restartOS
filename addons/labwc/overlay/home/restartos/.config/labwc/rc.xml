<?xml version="1.0"?>

<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <!-- outputs are enabled by kanshi (and kept off while idle by restartos-display) -->
  <core>
    <autoEnableOutputs>no</autoEnableOutputs>
  </core>

  <theme>
    <name></name>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <desktops number="4" />
  <keyboard>
    <default/>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-s">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | swappy -f -'</command>
      </action>
    </keybind>
    <keybind key="C-S-Print">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | swappy -f -'</command>
      </action>
    </keybind>
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" - | swappy -f -'</command>
      </action>
    </keybind>

    <!-- Use a different terminal emulator -->
    <keybind key="W-Return">
      <action name="Execute" command="lxterminal" />
    </keybind>
    <keybind key="W-l">
      <action name="Lock Screen">
	<command>swaylock -f -c 000000</command>
      </action>
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>
    <!--
      Re-fit every maximized window (incl. covered ones / other desktops) to the
      current usable area. restartos-display sends this with wtype after resume:
      labwc 0.8.3 has no IPC, and an output nudge only re-fits the visible window.
    -->
    <keybind key="W-A-S-F12">
      <action name="ForEach">
        <query maximized="both" />
        <then>
          <action name="UnMaximize" />
          <action name="Maximize" />
        </then>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Show a custom menu on desktop right click -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="some-custom-menu" />
      </mousebind>
    </context>
  </mouse>

  <!--
    Open app windows maximized (not dialogs: Wayland windows with a parent or
    fixed size are type "dialog"). Only maximized windows keep clear of waybar
    after resume - see the W-A-S-F12 keybind above.
  -->
  <windowRules>
    <windowRule identifier="*" type="normal">
      <action name="Maximize" />
    </windowRule>
  </windowRules>

</labwc_config>
