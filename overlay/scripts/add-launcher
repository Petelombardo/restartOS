ICON="$2"
APP="$1"

if [ "$APP" == "" ]; then
        echo "Usage:  add-launcher [/path/to/app] [/path/to/icon]"
fi

echo "[launcher]" >> /home/restartos/.config/weston.ini
echo "icon=${ICON}" >> /home/restartos/.config/weston.ini
echo "path=${APP}" >> /home/restartos/.config/weston.ini
echo "" >> /home/restartos/.config/weston.ini
