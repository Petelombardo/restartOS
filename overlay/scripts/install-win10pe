#!/bin/bash

if [ "$1" == "" ]; then
        echo "Usage: install-win10pe [path/to/Win10PE.iso]"
        exit
fi

show_errors() {
	if [ ! "$ERROR" == "" ]; then
		echo "$ERROR"
		exit
	fi
}

FILENAME=$(basename "$1")

echo "Mounting the ISO"
mkdir tempiso
mount "$1" -o loop tempiso || ERROR="Failed to mount the ISO"
show_errors

echo "Mounting the EFI boot partition of your USB Flash Drive"
mkdir tempusb
mount LABEL="Data" tempusb || ERROR="Failed to mount the flash drive"
show_errors
GRUBCFG=$(find ./tempusb -name "grub.cfg")

echo "Copying Win10PE Files to your USB Flash Drive"
cp -avR tempiso/efi/boot tempusb/EFI/BOOT/PE
rsync -av tempiso/boot tempusb/
rsync -av tempiso/sources tempusb
rsync -av tempiso/efi/microsoft tempusb/EFI/
cp tempiso/* tempusb/

echo "Creating a menu entry for Win 10 PE"
echo "menuentry \"$FILENAME Rescue\" {
        set root=(hd0,1)
        chainloader (\$root)/EFI/BOOT/PE/bootx64.efi
}" >> $GRUBCFG

echo "Cleaning everything up"
umount tempiso
umount tempusb
rmdir tempiso tempusb
sync

echo "Finished"
