#!/bin/bash

IFS="
"
FAIL=0

## Prepping new folders ##
mkdir -p /mnt/d1
mkdir -p /mnt/d2


## Mount source files ##
USBCD=$(lsblk -n -o PKNAME $(readlink -f /dev/disk/by-label/CDROM) | grep -v "^$")

if [ "$USBCD" == "" ]; then
	clear
	BEFORE=`lsblk -l -e 7 -e 11 | sed -e 's/  */ /g' | grep -v "^[a-z]*[0-9]" | grep -v "NAME" | cut -d' ' -f1,4`
	echo "Insert USB Drive"
	COUNT=0
	while [ "$disk" == "" ] && [ $COUNT -lt 30 ];
	do
		AFTER=`lsblk -l -e 7 -e 11 | sed -e 's/  */ /g' | grep -v "^[a-z]*[0-9]" | grep -v "NAME" | cut -d' ' -f1,4`
		DISKINFO=`echo "$AFTER" | grep -v "$BEFORE" | grep -v "^$"`
			disk=`echo $DISKINFO | cut -d' ' -f1`
		sleep 1
		if [ ! "$disk" == "" ]; then
			echo
		else
			echo -n "."
			COUNT=$((COUNT+1))
		fi
	done
else
	disk=$USBCD
	DISKINFO=$USBCD
fi

count=0
bold=$(tput bold)
normal=$(tput sgr0)

if [ ! "$1" == "" ]; then
	disk="$(echo "$1" | sed -e 's/\/dev\///')"
fi

if [ "$disk" == "" ]; then
	echo ""
	echo "ID        Disk"
	for i in `lsblk -l -e 7 -e 11 | sed -e 's/  */ /g' | grep -v "^[a-z]*[0-9]" | grep -v "NAME" | cut -d' ' -f1,4`
	do
	        count=$((count+1))
	        echo "$count    $i"
	        disks="$disks"$'\n'"$count $i"
	done
	echo ""
	echo -n "Type the ID matching the disk that you wish to ${bold}overwrite${normal}: "
	read disknum
	DISKINFO=`echo "$disks" | grep "^$disknum " | cut -d' ' -f 2-`
	disk=`echo "$DISKINFO" | cut -d' ' -f1`
fi

if [ "$disk" == "" ]; then
        echo "Sorry, but that is not a valid selection. Exiting."
        exit
fi

DISKINFO=`lsblk /dev/${disk} -n -o SIZE,TYPE,MODEL | grep disk | cut -d' ' -f1,3-`

if [ -f /mnt/boot/static-addons-persistent.img ]; then
	echo -n "Do you want to copy over your persistent data? [n]: "
	read persistent
	case "$persistent" in
		y|Y|yes)
			EXCLUDE=""
			;;
		*)
			EXCLUDE=$(echo -n --exclude="static-addons-persistent.img")
			;;
	esac
	echo ""
fi


echo -n "Ready to overwrite disk ${bold}$DISKINFO($disk)${normal}? [n]: "
read choice
if [ ! "$choice" == "y" ] && [ ! "$choice" == "Y" ] && [ ! "$choice"  == "yes" ]; then
        echo "Action Aborted"
        exit
fi

for i in `mount | grep /dev/${disk} | cut -d' ' -f1`
do
	umount $i
done

echo "Clearing boot record"
dd if=/dev/zero of=/dev/$disk bs=1M count=100

TOTALSECTORS=`fdisk -l /dev/$disk | grep "Disk /dev/$disk" | cut -d',' -f3 | cut -d' ' -f2`
AVAILABLESECTORS=$((TOTALSECTORS-2048))
echo $TOTALSECTORS total, $AVAILABLESECTORS available

TOTALBYTES=`sfdisk -s /dev/$disk`
PARTEND=$((TOTALBYTES-1048577))
PARTEND=$((PARTEND*2))
VERYEND=$((TOTALBYTES*2))
VERYEND=$((VERYEND-2049))
VERYEND=$((VERYEND-PARTEND))

## Create the partition table ##
echo "Creating the partition table"
sfdisk --force /dev/$disk -uS << EOF
2048,$PARTEND,b
$((PARTEND+2049)),$VERYEND,,*
EOF

sleep 1
for i in `mount | grep /dev/${disk} | cut -d' ' -f1`
do
        umount $i
done

## Create the filesystem and set the UUID and label (necessary for booting from the initrd) ##
echo "Creating the new filesystem"
mkfs.ext4 -F /dev/${disk}2 -L restartos
mkfs.vfat -F32 /dev/${disk}1 -n Data
echo "Setting up the proper UUID for the boot media"
tune2fs /dev/${disk}2 -U bfc78250-6182-4e41-818f-b5f9b4d6c0ba

## Mount the new filesystem ##
mkdir -p /mnt/d2
mkdir -p /mnt/d1
mount /dev/${disk}2 /mnt/d2 || FAIL=1
mount /dev/${disk}1 /mnt/d1 || FAIL=1

## Copy files to the new filesystem ##
echo "** Copying the system files **"
cp -av /mnt/boot/system*.img /mnt/d2/
cp -av /mnt/boot/version /mnt/d2/
echo "** Copying boot files **"
# boot.tar.gz and efi.tar.gz are the prebuilt grub kit from image/make-iso;
# they are kept on the stick too so it can make further sticks
cp /mnt/boot/boot.tar.gz /mnt/d2/ || FAIL=1
tar -xf /mnt/boot/boot.tar.gz -C /mnt/d2/ --no-same-owner || FAIL=1
mkdir -p /mnt/d2/isolinux
cp -av /mnt/boot/vmlinuz64 /mnt/boot/initrd.img /mnt/d2/isolinux/ || FAIL=1
echo "** Copying EFI boot folder **"
cp /mnt/boot/efi.tar.gz /mnt/d2/ || FAIL=1
tar -xf /mnt/boot/efi.tar.gz -C /mnt/d1/ --no-same-owner || FAIL=1
echo "** Copying add-on packages **"
rsync -av ${EXCLUDE} /mnt/boot/static-addons-*.img /mnt/d2/

## Install grub for legacy BIOS boot: boot.img in the MBR (440 bytes, leaving
## the partition table alone) and core.img in the gap before partition 1.
## UEFI boot needs nothing more than EFI/boot/bootx64.efi on partition 1.
echo "Installing the bootloader"
dd if=/mnt/d2/boot/grub/i386-pc/boot.img of=/dev/${disk} bs=440 count=1 conv=notrunc,fsync || FAIL=1
dd if=/mnt/d2/boot/grub/i386-pc/core.img of=/dev/${disk} bs=512 seek=1 conv=notrunc,fsync || FAIL=1

## Wait for disk to sync, then cleanup ##
echo "Waiting for data to finish writing to your disk."
sync
#clear
umount /mnt/d2
umount /mnt/d1
if [ $FAIL -ne 0 ]; then
	echo "${bold}Something went wrong above; this USB drive may not boot.${normal}"
	exit 1
fi
echo "Your new USB drive is ready!"


