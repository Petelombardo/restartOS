#!/bin/bash
# Give each machine a unique, stable hostname: restartos-<last 2 MAC octets>.
# Only touches the stock "restartos" name, so a custom /etc/hostname (made
# persistent) or systemd.hostname= on the kernel cmdline is left alone.
# Runs from restartos-hostname.service, before NetworkManager and avahi.

DEFAULT=restartos

[ "$(cat /etc/hostname 2>/dev/null)" = "$DEFAULT" ] || exit 0
grep -q 'systemd.hostname=' /proc/cmdline && exit 0

# First physical NIC by name, preferring wired over wireless.
pick_nic() {
	local i
	for wireless in no yes; do
		for i in $(ls /sys/class/net | sort); do
			[ -e "/sys/class/net/$i/device" ] || continue
			if [ -d "/sys/class/net/$i/wireless" ]; then
				[ $wireless = yes ] || continue
			else
				[ $wireless = no ] || continue
			fi
			echo "$i"
			return
		done
	done
}

# NIC drivers may still be probing this early; wait up to 5s.
for n in $(seq 50); do
	NIC=$(pick_nic)
	[ -n "$NIC" ] && break
	sleep 0.1
done
[ -n "$NIC" ] || { echo "set-hostname: no NIC found, keeping $DEFAULT"; exit 0; }

MAC=$(cat "/sys/class/net/$NIC/address")
NAME="$DEFAULT-$(echo "$MAC" | awk -F: '{print $5 $6}')"

echo "$NAME" > /etc/hostname
hostname "$NAME"
sed -i "s/\b$DEFAULT\$/$NAME/; s/\b$DEFAULT /$NAME /" /etc/hosts
echo "set-hostname: $NAME (from $NIC $MAC)"
